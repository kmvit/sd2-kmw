<script src="/js/scripts.js"></script>
<script>
    $(document).ready(function() {
        var $mainMenu = $('.menu-block');
        var hHeader = parseInt( $('header').css('height') );
        var hMenu = parseInt( $mainMenu.css('height') );
                    var hFixed = ( hHeader - hMenu );
                var $menuClone = $mainMenu.clone(true).addClass("fixed-menu").appendTo('header');
        $(window).scroll(function () {
            if ($(window).scrollTop() > hFixed) {
                $menuClone.fadeIn(300);
            } else {
                $menuClone.fadeOut(300);
            }
        } );

        $("body").append("<div style='display:none;' id='preload-images-container'></div>");
        var $mfp = $('.mfp-with-zoom');
        var $imgContainer = $("#preload-images-container");

        $mfp.on("mouseenter", function () {
            var $this = $(this);
            var href = $this.attr("href").trim();
            var $img = $imgContainer.find("[src='"+href+"']");

            if ( $img.length !== 1 ) {
                $imgContainer.append("<img src='"+href+"'>");
            }
        });

        $mfp.magnificPopup({
            type: 'image',
            mainClass: 'mfp-with-zoom',
            zoom: {
                enabled: true,
                duration: 500,
                easing: 'ease-in-out'
            },
            closeOnContentClick: true,
            closeOnBgClick: true,
            preloader: false,
            callbacks: {}
        });
    } );
</script>


